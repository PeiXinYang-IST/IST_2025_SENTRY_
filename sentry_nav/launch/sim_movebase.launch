<?xml version="1.0"?>
<launch>

  <!-- <node name="map_server" pkg="map_server" type="map_server" args="$(find auto_nav)/map/map_game.yaml" output="screen"> -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(find sentry_nav)/map/rmuc_map_draw.yaml" output="screen">
   <param name="frame_id" value="map" />
  </node>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find sentry_nav)/config/auto_navi_demo.rviz"/>

  <!-- <include file="$(find auto_nav)/launch/amcl_simple_meca_car.launch"/> -->
  <!-- <include file="$(find scan_to_map)/launch/scan_to_map_location.launch"/> -->

  
  <!--Launch the move base with time elastic band-->
  <param name="/use_sim_time" value="true"/>
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <rosparam file="$(find sentry_nav)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find sentry_nav)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find sentry_nav)/param/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find sentry_nav)/param/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find sentry_nav)/param/teb_local_planner_params.yaml" command="load" />
    
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    <!--<param name="neutral_cost" value="220" />-->
    <param name="planner_frequency" value="3.0" />
    <param name="planner_patience" value="5.0" />
    <param name="use_dijkstra" value="false" />
    
    <!-- <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <param name="controller_frequency" value="20.0" />
    <param name="controller_patience" value="15.0" /> -->

    <param name="clearing_rotation_allowed" value="false" />
    <remap from="/cmd_vel" to="/" />
 
  </node>
    <node pkg="sentry_nav" type="pid_follow" name="pid_follow" output="screen" respawn="true" >
    <param name = "max_speed" value = "1.2" />
    <param name = "pid_p" value = "1.0" />
    <param name = "pid_i" value = "0.1" />
    <param name = "pid_d" value = "1.0" />
    <param name = "i_max_" value = "0.1" />
    <param name = "set_yaw_speed" value = "0.6" />
    <param name = "goal_dist_tolerance" value = "0.6" />
    <param name = "far_goal_dist_tolerance" value = "0.5"/>
    <param name = "far_far_goal_dist_tolerance" value = "1.0"/>
    <param name = "alpha" value = "0.25"/>
    <param name = "set_max_yaw_speed_" value = "1.0"/>
    </node>

</launch>
