<!--?xml version="1.4" ?-->
<sdf version="1.6">
  <world name="my_world">
    <!-- 环境光 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/White</name>
      </script>
    </include>
    <gravity>0 0 -1200</gravity>
    <!--模型 -->
    <model name='model_name'>
      <include>
        <uri>model://rmuc_2025</uri><!--核心-->
      </include>
    </model>
    
  </world>
</sdf>
